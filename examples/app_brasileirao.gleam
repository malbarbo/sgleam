// Dados reais OpenFootball, execução exclusivamente fake.
import gleam/int
import gleam/list
import gleam/order
import gleam/result
import gleam/string
import sgleam/check
import sgleam/show/app
import sgleam/show/button
import sgleam/show/element.{type Element}
import sgleam/show/html
import sgleam/show/layout
import sgleam/show/link
import sgleam/show/picker
import sgleam/show/text
import sgleam/show/text_input
import sgleam/task.{type Task}
import sgleam/task/fake

const url =
  "https://raw.githubusercontent.com/openfootball/football.json/master/2025/br.1.json"

type Match {
  Match(id: Int, round: Int, home: String, away: String, hg: Int, ag: Int)
}

type Standing {
  Standing(
    team: String,
    played: Int,
    wins: Int,
    draws: Int,
    losses: Int,
    gf: Int,
    ga: Int,
  )
}

type Model {
  Model(
    original: List(Match),
    matches: List(Match),
    round: Int,
    selected: Int,
    home_score: String,
    away_score: String,
    status: String,
    changed: Bool,
  )
}

type Msg {
  Received(Result(String, task.HttpError))
  Round(String)
  Select(String)
  HomeScore(String)
  AwayScore(String)
  Simulate
  Restore
}

fn request() -> Task(Msg) {
  use response <- task.get(url)
  task.done(Received(response))
}

fn init() -> #(Model, Task(Msg)) {
  #(
    Model([], [], 38, 0, "", "", "Carregando resposta fake...", False),
    request(),
  )
}

fn choose(model: Model, id: Int) -> Model {
  case list.find(model.matches, fn(m) { m.id == id }) {
    Ok(m) ->
      Model(
        ..model,
        selected: id,
        home_score: int.to_string(m.hg),
        away_score: int.to_string(m.ag),
      )
    Error(_) -> model
  }
}

fn update(model: Model, msg: Msg) -> #(Model, Task(Msg)) {
  case msg {
    Received(Error(_)) -> #(
      Model(..model, status: "Falha HTTP simulada. Dados atuais preservados."),
      task.none(),
    )
    Received(Ok(body)) -> {
      case read_matches(body) {
        Error(_) -> #(Model(..model, status: "JSON inválido."), task.none())
        Ok(matches) -> #(
          choose(
            Model(
              ..model,
              original: matches,
              matches:,
              changed: False,
              status: int.to_string(list.length(matches)) <> " partidas carregadas.",
            ),
            0,
          ),
          task.none(),
        )
      }
    }
    Round(value) -> #(
      Model(..model, round: result.unwrap(int.parse(value), model.round)),
      task.none(),
    )
    Select(value) -> #(
      choose(model, result.unwrap(int.parse(value), model.selected)),
      task.none(),
    )
    HomeScore(value) -> #(Model(..model, home_score: value), task.none())
    AwayScore(value) -> #(Model(..model, away_score: value), task.none())
    Restore -> #(
      choose(
        Model(
          ..model,
          matches: model.original,
          changed: False,
          status: "Resultados originais restaurados.",
        ),
        model.selected,
      ),
      task.none(),
    )
    Simulate -> {
      case int.parse(model.home_score), int.parse(model.away_score) {
        Ok(h), Ok(a) if h >= 0 && a >= 0 && h <= 99 && a <= 99 -> {
          case list.find(model.matches, fn(m) { m.id == model.selected }) {
            Error(_) -> #(
              Model(..model, status: "Carregue os dados primeiro."),
              task.none(),
            )
            Ok(selected) -> {
              let matches =
                list.map(model.matches, fn(m) {
                  case m.id == model.selected {
                    True -> Match(..m, hg: h, ag: a)
                    False -> m
                  }
                })
              #(
                Model(
                  ..model,
                  matches:,
                  changed: True,
                  round: int.max(model.round, selected.round),
                  status: "Placar simulado aplicado. Tabela recalculada.",
                ),
                task.none(),
              )
            }
          }
        }
        _, _ -> #(
          Model(..model, status: "Informe placares inteiros entre 0 e 99."),
          task.none(),
        )
      }
    }
  }
}

fn points(s: Standing) -> Int {
  s.wins * 3 + s.draws
}

fn balance(s: Standing) -> Int {
  s.gf - s.ga
}

fn record(s: Standing, gf: Int, ga: Int) -> Standing {
  Standing(
    ..s,
    played: s.played + 1,
    gf: s.gf + gf,
    ga: s.ga + ga,
    wins: s.wins
      + case gf > ga {
        True -> 1
        False -> 0
      },
    draws: s.draws
      + case gf == ga {
        True -> 1
        False -> 0
      },
    losses: s.losses
      + case gf < ga {
        True -> 1
        False -> 0
      },
  )
}

fn compare(a: Standing, b: Standing) -> order.Order {
  case int.compare(points(b), points(a)) {
    order.Eq ->
      case int.compare(b.wins, a.wins) {
        order.Eq ->
          case int.compare(balance(b), balance(a)) {
            order.Eq ->
              case int.compare(b.gf, a.gf) {
                order.Eq -> string.compare(a.team, b.team)
                other -> other
              }
            other -> other
          }
        other -> other
      }
    other -> other
  }
}

fn standings(matches: List(Match), round: Int) -> List(Standing) {
  let teams =
    matches |> list.flat_map(fn(m) { [m.home, m.away] }) |> list.unique
  let initial = list.map(teams, fn(t) { Standing(t, 0, 0, 0, 0, 0, 0) })
  matches
  |> list.filter(fn(m) { m.round <= round })
  |> list.fold(initial, fn(table, m) {
    list.map(table, fn(s) {
      case s.team == m.home, s.team == m.away {
        True, _ -> record(s, m.hg, m.ag)
        _, True -> record(s, m.ag, m.hg)
        _, _ -> s
      }
    })
  })
  |> list.sort(compare)
}

fn label(m: Match) -> String {
  "R" <> int.to_string(m.round) <> ": " <> m.home <> " × " <> m.away
}

fn cell(value: String) -> Element(msg) {
  text.new(value) |> text.done
}

fn table_view(table: List(Standing)) -> Element(Msg) {
  let columns = [
    #("Time", fn(s: Standing) { s.team }),
    #("PTS", fn(s) { int.to_string(points(s)) }),
    #("J", fn(s: Standing) { int.to_string(s.played) }),
    #("V", fn(s: Standing) { int.to_string(s.wins) }),
    #("E", fn(s: Standing) { int.to_string(s.draws) }),
    #("D", fn(s: Standing) { int.to_string(s.losses) }),
    #("GP", fn(s: Standing) { int.to_string(s.gf) }),
    #("GC", fn(s: Standing) { int.to_string(s.ga) }),
    #("SG", fn(s) { int.to_string(balance(s)) }),
  ]
  let positions =
    layout.column([
      cell("#"),
      ..list.index_map(table, fn(_, i) { cell(int.to_string(i + 1)) })
    ])
    |> layout.done
  layout.row([
    positions,
    ..list.map(columns, fn(column) {
      let #(heading, display) = column
      layout.column([
        cell(heading),
        ..list.map(table, fn(s) { cell(display(s)) })
      ])
      |> layout.done
    })
  ])
  |> layout.done
}

fn rounds(n: Int) -> List(Int) {
  case n > 38 {
    True -> []
    False -> [n, ..rounds(n + 1)]
  }
}

fn view(model: Model) -> Element(Msg) {
  let table = standings(model.matches, model.round)
  layout.column([
    cell("Brasileirão 2025 — Classificação"),
    link.new(
      "Repositório: OpenFootball",
      "https://github.com/openfootball/football.json",
    )
      |> link.new_tab(True)
      |> link.done,
    cell(model.status),
    layout.row([
      cell("Até a rodada"),
      picker.new(
        list.map(rounds(0), fn(n) {
          picker.choice(int.to_string(n), int.to_string(n))
        }),
      )
        |> picker.selected(int.to_string(model.round))
        |> picker.on_select(Round)
        |> picker.done,
      cell(case model.changed {
        True -> "SIMULAÇÃO"
        False -> "Resultados originais"
      }),
    ])
      |> layout.done,
    cell("Filtro por rodada; não representa a cronologia dos jogos adiados."),
    table_view(table),
    cell(
      "Ordem: pontos, vitórias, saldo, gols pró e nome (desempate didático).",
    ),
    cell("Não reproduz todos os critérios oficiais de desempate."),
    cell("Simular um resultado"),
    picker.new(
      list.map(model.matches, fn(m) {
        picker.choice(label(m), int.to_string(m.id))
      }),
    )
      |> picker.selected(int.to_string(model.selected))
      |> picker.on_select(Select)
      |> picker.enabled(!list.is_empty(model.matches))
      |> picker.done,
    layout.row([
      cell("Mandante"),
      text_input.new(model.home_score)
        |> text_input.on_input(HomeScore)
        |> text_input.done,
      cell("Visitante"),
      text_input.new(model.away_score)
        |> text_input.on_input(AwayScore)
        |> text_input.done,
    ])
      |> layout.done,
    layout.row([
      button.new("Aplicar placar")
        |> button.on_press(Simulate)
        |> button.enabled(!list.is_empty(model.matches))
        |> button.done,
      button.new("Restaurar resultados")
        |> button.on_press(Restore)
        |> button.done,
    ])
      |> layout.done,
  ])
  |> layout.done
}

pub fn main() {
  app.create(init, view, update)
  |> app.run_with(fn(program) {
    fake.messages(program, [
      fake.GetResponse(url, Ok(snapshot())),
    ])
  })
}

// Leitor restrito ao snapshot: objetos, arrays, strings e inteiros positivos.
// Não é um parser JSON geral: rejeita floats, null e escapes Unicode.
type Json {
  Object(List(#(String, Json)))
  Array(List(Json))
  Str(String)
  Num(Int)
}

fn whitespace(chars: List(String)) -> List(String) {
  case chars {
    [" ", ..rest] | ["\n", ..rest] | ["\r", ..rest] | ["\t", ..rest] ->
      whitespace(rest)
    _ -> chars
  }
}

fn quoted(
  chars: List(String),
  acc: String,
) -> Result(#(String, List(String)), Nil) {
  case chars {
    ["\"", ..rest] -> Ok(#(acc, rest))
    ["\\", escaped, ..rest] ->
      case escaped {
        "\"" | "\\" | "/" -> quoted(rest, acc <> escaped)
        "n" -> quoted(rest, acc <> "\n")
        "r" -> quoted(rest, acc <> "\r")
        "t" -> quoted(rest, acc <> "\t")
        _ -> Error(Nil)
      }
    [char, ..rest] -> quoted(rest, acc <> char)
    [] -> Error(Nil)
  }
}

fn number(
  chars: List(String),
  acc: String,
) -> Result(#(Json, List(String)), Nil) {
  case chars {
    [char, ..rest]
      if char == "0"
      || char == "1"
      || char == "2"
      || char == "3"
      || char == "4"
      || char == "5"
      || char == "6"
      || char == "7"
      || char == "8"
      || char == "9"
    -> number(rest, acc <> char)
    _ -> {
      use value <- result.try(int.parse(acc))
      Ok(#(Num(value), chars))
    }
  }
}

fn parse(chars: List(String)) -> Result(#(Json, List(String)), Nil) {
  case whitespace(chars) {
    ["{", ..rest] -> object(rest, [])
    ["[", ..rest] -> array(rest, [])
    ["\"", ..rest] -> {
      use pair <- result.try(quoted(rest, ""))
      Ok(#(Str(pair.0), pair.1))
    }
    rest -> number(rest, "")
  }
}

// Keep iteration over siblings directly tail-recursive. A use/result.try
// callback around the recursive call retains one stack frame per JSON item.
fn object(
  chars: List(String),
  acc: List(#(String, Json)),
) -> Result(#(Json, List(String)), Nil) {
  case whitespace(chars) {
    ["}", ..rest] -> Ok(#(Object(list.reverse(acc)), rest))
    ["\"", ..rest] -> {
      case quoted(rest, "") {
        Error(_) -> Error(Nil)
        Ok(#(key, after_key)) -> {
          case whitespace(after_key) {
            [":", ..rest] -> {
              case parse(rest) {
                Error(_) -> Error(Nil)
                Ok(#(value, after_value)) -> {
                  let acc = [#(key, value), ..acc]
                  case whitespace(after_value) {
                    [",", ..rest] -> object(rest, acc)
                    ["}", ..rest] -> Ok(#(Object(list.reverse(acc)), rest))
                    _ -> Error(Nil)
                  }
                }
              }
            }
            _ -> Error(Nil)
          }
        }
      }
    }
    _ -> Error(Nil)
  }
}

fn array(
  chars: List(String),
  acc: List(Json),
) -> Result(#(Json, List(String)), Nil) {
  case whitespace(chars) {
    ["]", ..rest] -> Ok(#(Array(list.reverse(acc)), rest))
    rest -> {
      case parse(rest) {
        Error(_) -> Error(Nil)
        Ok(#(value, after_value)) -> {
          let acc = [value, ..acc]
          case whitespace(after_value) {
            [",", ..rest] -> array(rest, acc)
            ["]", ..rest] -> Ok(#(Array(list.reverse(acc)), rest))
            _ -> Error(Nil)
          }
        }
      }
    }
  }
}

fn field(value: Json, key: String) -> Result(Json, Nil) {
  case value {
    Object(fields) -> {
      use pair <- result.try(list.find(fields, fn(p) { p.0 == key }))
      Ok(pair.1)
    }
    _ -> Error(Nil)
  }
}

fn string_field(value: Json, key: String) -> Result(String, Nil) {
  use value <- result.try(field(value, key))
  case value {
    Str(s) -> Ok(s)
    _ -> Error(Nil)
  }
}

fn score(value: Json) -> Result(#(Int, Int), Nil) {
  case value {
    Array([Num(h), Num(a)]) if h >= 0 && a >= 0 -> Ok(#(h, a))
    Object(_) -> {
      use ft <- result.try(field(value, "ft"))
      score(ft)
    }
    _ -> Error(Nil)
  }
}

fn match_from_json(value: Json, id: Int) -> Result(Match, Nil) {
  use home <- result.try(string_field(value, "team1"))
  use away <- result.try(string_field(value, "team2"))
  use round <- result.try(string_field(value, "round"))
  use round <- result.try(int.parse(string.replace(round, "Matchday ", "")))
  use raw_score <- result.try(field(value, "score"))
  use goals <- result.try(score(raw_score))
  case round >= 1 && round <= 38 && home != away {
    True -> Ok(Match(id, round, home, away, goals.0, goals.1))
    False -> Error(Nil)
  }
}

fn read_matches(body: String) -> Result(List(Match), Nil) {
  use parsed <- result.try(parse(string.to_graphemes(body)))
  case whitespace(parsed.1) {
    [] -> {
      use matches <- result.try(field(parsed.0, "matches"))
      case matches {
        Array(items) -> items |> list.index_map(match_from_json) |> result.all
        _ -> Error(Nil)
      }
    }
    _ -> Error(Nil)
  }
}

pub fn classification_examples() {
  let games = [Match(0, 1, "A", "B", 2, 0), Match(1, 2, "B", "A", 1, 1)]
  let assert [a, b] = standings(games, 2)
  check.eq(#(a.team, points(a), a.played, a.wins, a.draws, a.gf, a.ga), #(
    "A",
    4,
    2,
    1,
    1,
    3,
    1,
  ))
  check.eq(#(b.team, points(b), b.losses), #("B", 1, 1))
  check.eq(list.map(standings(games, 0), points), [0, 0])
  let assert [first, ..] = standings(games, 1)
  check.eq(points(first), 3)
}

pub fn snapshot_examples() {
  let assert Ok(matches) = read_matches(snapshot())
  check.eq(list.length(matches), 380)
  let table = standings(matches, 38)
  check.eq(list.length(table), 20)
  check.true(list.all(table, fn(s) { s.played == 38 }))
  check.eq(
    list.fold(table, 0, fn(sum, s) { sum + s.gf }),
    list.fold(table, 0, fn(sum, s) { sum + s.ga }),
  )
  check.eq(read_matches("{}"), Error(Nil))
  check.eq(read_matches(snapshot() <> " lixo"), Error(Nil))
  check.eq(score(Array([Num(1), Num(2)])), Ok(#(1, 2)))
  check.eq(score(Object([#("ft", Array([Num(1), Num(2)]))])), Ok(#(1, 2)))
}

pub fn simulation_examples() {
  let #(empty, load) = init()
  let report = fake.run(load, [fake.GetResponse(url, Ok(snapshot()))])
  let assert Ok(message) = report.result
  let #(loaded, _) = update(empty, message)
  let edited = Model(..loaded, home_score: "9", away_score: "0")
  let #(simulated, _) = update(edited, Simulate)
  check.true(simulated.changed)
  check.false(simulated.matches == loaded.matches)
  let #(restored, _) = update(simulated, Restore)
  check.eq(restored.matches, loaded.matches)
  let #(invalid, _) = update(Model(..loaded, home_score: "-1"), Simulate)
  check.eq(invalid.matches, loaded.matches)
  let #(failed, _) = update(loaded, Received(Error(task.NetworkError)))
  check.eq(failed.matches, loaded.matches)
}

pub fn view_examples() {
  let #(empty, _) = init()
  check.true(string.contains(html.to_html(view(empty)), "Carregando"))
  let assert Ok(matches) = read_matches(snapshot())
  let loaded = choose(Model(..empty, matches:, original: matches), 0)
  let markup = html.to_html(view(loaded))
  check.true(string.contains(markup, "<select"))
  check.true(string.contains(markup, "São Paulo FC"))
  check.true(string.contains(markup, "Restaurar resultados"))
  let #(bad_json, _) = update(loaded, Received(Ok("{}")))
  check.eq(bad_json.matches, loaded.matches)
  let #(invalid, _) = update(Model(..loaded, home_score: "1.5"), Simulate)
  check.eq(invalid.matches, loaded.matches)
  let #(selected, _) = update(loaded, Select("379"))
  let #(applied, _) =
    update(
      Model(..selected, round: 1, home_score: "1", away_score: "0"),
      Simulate,
    )
  check.eq(applied.round, 38)
  check.eq(list.length(applied.matches), 380)
}

pub fn tiebreak_examples() {
  let a = Standing("A", 2, 1, 0, 1, 3, 2)
  let b = Standing("B", 2, 1, 0, 1, 2, 1)
  check.eq(compare(a, b), order.Lt)
  check.eq(compare(a, Standing(..b, gf: 5, ga: 1)), order.Gt)
  check.eq(compare(a, Standing(..b, wins: 0, draws: 3)), order.Lt)
  check.eq(compare(a, Standing(..a, team: "Z")), order.Lt)
}

